<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Direct (notarized) distribution, not sandboxed — required so Helm can
	     receive Full Disk Access and clean the whole drive. For notarization,
	     also enable the Hardened Runtime in the Xcode target. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Required under the Hardened Runtime so the Startup tool can read login
	     items and Quick Actions can drive Finder / System Events via osascript.
	     Without it those features fail silently in a notarized build. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
